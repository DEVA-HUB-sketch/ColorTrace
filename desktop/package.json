{
  "name": "colortrace-desktop",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "main": "dist-electron/main.js",
  "scripts": {
    "dev": "npm run build:electron && concurrently --names vite,electron \"vite\" \"npx electron dist-electron/main.js\"",
    "build": "vite build && npm run build:electron",
    "build:electron": "tsc -p tsconfig.electron.json",
    "preview": "vite preview",
    "package": "electron-builder"
  },
  "dependencies": {
    "@tanstack/react-table": "^8.17.0",
    "axios": "^1.7.7",
    "electron": "^31.0.2",
